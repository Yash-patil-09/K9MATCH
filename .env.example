# ==============================================================================
# K9Match Production & Development Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your project root and update the values:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Security & Host Settings
# ------------------------------------------------------------------------------
# Generate a secure key in production (e.g., using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
SECRET_KEY=django-insecure-k9match-sample-secret-key-replace-in-production

# Set to False in production!
DEBUG=True

# Comma-separated list of valid hostnames/domains
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# ------------------------------------------------------------------------------
# 2. Production SSL & Cookie Hardening (Set to True on HTTPS domains)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# If left empty/commented out, K9Match falls back automatically to local db.sqlite3
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 4. Persistent Cloud Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
# If omitted, uploads are stored locally in the /media/ directory.
# In production cloud containers (Render/Railway), provide Cloudinary credentials
# so dog photos persist across restarts and deploys.
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. Email Notification Engine (Gmail SMTP)
# ------------------------------------------------------------------------------
# For match proposal, acceptance, and decline notifications.
# If omitted, emails are printed directly to the developer console.
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_16_character_app_password

# ------------------------------------------------------------------------------
# 6. Google OAuth2 Social Authentication
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------------------------------------------
# 7. Google Maps / Places API (Dynamic Vet Discovery Engine)
# ------------------------------------------------------------------------------
# Enables live geolocation, autocomplete, and veterinary search nationwide.
# GOOGLE_MAPS_API_KEY=your_google_maps_places_api_key
