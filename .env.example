# ==========================================
# K9Match Environment Configuration Template
# Copy this file to .env and adjust variables
# ==========================================

# Django Core Secret Key
SECRET_KEY=django-insecure-k9match-sample-secret-key-replace-in-production

# Debug Mode (True for local development, False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# SSL & Cookie Security (Set to True in production with HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Optional: Supabase / PostgreSQL Connection URL (for Phase 4)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
